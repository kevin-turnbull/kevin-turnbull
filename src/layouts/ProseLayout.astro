---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="page-wrap page-section stack-lg">
    <header class="stack-md">
      {eyebrow && <p class="muted">{eyebrow}</p>}
      <h1 class="section-title">{title}</h1>
      {description && <p class="lede">{description}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
