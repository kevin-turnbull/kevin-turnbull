---
import Wordmark from "../brand/Wordmark.astro";
import CtaGroup from "../brand/CtaGroup.astro";
import type { SiteProfile } from "../../lib/content";

interface Props {
  profile: SiteProfile;
}

const { profile } = Astro.props;
const ctaLabel =
  profile.availability === "open"
    ? "Start a conversation"
    : profile.availability === "selective"
      ? "Discuss a fit"
      : "Say hello";
---

<section class="hero" aria-label="Introduction">
  <div class="hero-media" aria-hidden="true">
    <img
      class="hero-media-motion"
      src={profile.heroImage}
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero-grade" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>

  <div class="hero-content page-wrap">
    <span class="hero-signal" aria-hidden="true"></span>
    <Wordmark name={profile.fullName} />
    <div class="hero-lower">
      <p class="hero-headline reveal" style="--reveal-delay: 520ms">{profile.headline}</p>
      <div class="hero-aside">
        <p class="hero-support reveal" style="--reveal-delay: 640ms">
          {profile.supportingSentence}
        </p>
        <CtaGroup
          class="reveal"
          tone="night"
          primaryHref="/contact"
          primaryLabel={ctaLabel}
          secondaryHref="/work"
          secondaryLabel="Selected work"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-content: end;
    min-block-size: 100svh;
    padding-block: calc(var(--nav-height) + 2rem) clamp(3rem, 8vh, 6rem);
    background-color: var(--night);
    color: var(--paper);
    overflow: clip;
  }

  .hero-media,
  .hero-grade,
  .hero-grid {
    position: absolute;
    inset: 0;
  }

  .hero-media img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: saturate(0.48) contrast(1.08) brightness(0.82);
  }

  /* Cool the photograph toward the ink so the emerald reads as the only signal. */
  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #0b2a3a;
    mix-blend-mode: color;
    opacity: 0.38;
  }

  .hero-grade {
    background:
      radial-gradient(115% 85% at 80% 6%, rgba(79, 227, 187, 0.15), transparent 58%),
      linear-gradient(
        180deg,
        rgba(4, 9, 15, 0.8) 0%,
        rgba(4, 9, 15, 0.2) 26%,
        rgba(4, 9, 15, 0.62) 64%,
        rgba(4, 9, 15, 0.96) 100%
      ),
      linear-gradient(94deg, rgba(4, 9, 15, 0.72) 0%, rgba(4, 9, 15, 0.1) 62%);
  }

  /* Drafting grid: the only ornament, and it is measured rather than decorative. */
  .hero-grid {
    --atmosphere-opacity: 0.42;
    opacity: 0.42;
    background-image: linear-gradient(90deg, rgba(255, 255, 255, 0.16) 0 1px, transparent 1px);
    background-size: calc(100% / 9) 100%;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 24%, #000 60%, transparent 94%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 24%, #000 60%, transparent 94%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-signal {
    display: block;
    margin-block-end: clamp(1.25rem, 3vh, 2rem);
  }

  .hero-lower {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    margin-block-start: clamp(1.5rem, 4vh, 2.75rem);
  }

  .hero-headline {
    max-inline-size: 20ch;
    font-size: clamp(1.25rem, 2.3vw, 1.9rem);
    font-weight: 300;
    line-height: 1.22;
    letter-spacing: -0.012em;
    color: var(--paper);
    text-wrap: balance;
  }

  .hero-aside {
    display: grid;
    gap: clamp(1.35rem, 3vw, 1.9rem);
    justify-items: start;
  }

  .hero-support {
    max-inline-size: 34rem;
    font-weight: 300;
    color: var(--paper-soft);
  }

  .hero :global(.cta-group) {
    --reveal-delay: 760ms;
  }

  @media (min-width: 64rem) {
    .hero-lower {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      column-gap: clamp(2.5rem, 6vw, 5.5rem);
      align-items: end;
    }
  }
</style>
