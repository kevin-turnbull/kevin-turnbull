---
import { formatContentDate } from "../../lib/dates";

interface Props {
  items: {
    slug: string;
    title: string;
    type: string;
    date: Date;
    abstract: string;
  }[];
}

const { items } = Astro.props;
---

{
  items.length === 0 ? (
    <div class="empty-state">
      <p class="eyebrow">In progress</p>
      <h2 class="section-title">Notes forthcoming</h2>
      <p class="lede">
        Essays and talks will land here. Meanwhile, explore selected work or start a conversation.
      </p>
      <div class="cta-group">
        <a class="btn btn-secondary" href="/work">
          Selected work
        </a>
        <a class="btn btn-primary" href="/contact">
          Contact
        </a>
      </div>
    </div>
  ) : (
    <ul class="writing-list">
      {items.map((item, index) => (
        <li class="writing-item">
          <a class="entry-link" href={`/writing/${item.slug}`}>
            <span class="entry-index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div class="meta">
              <span>{item.type}</span>
              <span>{formatContentDate(item.date)}</span>
            </div>
            <h2 class="entry-title">{item.title}</h2>
            <p class="entry-summary">{item.abstract}</p>
            <span class="entry-arrow" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  )
}
