---
interface Props {
  items: { title: string; body: string }[];
}
const { items } = Astro.props;
---

<ul class="philosophy-list">
  {
    items.map((item) => (
      <li class="philosophy-item stack-md">
        <h2 class="font-display" style="font-size:1.5rem;">{item.title}</h2>
        <p>{item.body}</p>
      </li>
    ))
  }
</ul>
