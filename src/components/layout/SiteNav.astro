---
import type { SiteProfile } from "../../lib/content";

interface Props {
  profile: SiteProfile;
  overlay?: boolean;
}

const { profile, overlay = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/writing", label: "Writing" },
  { href: "/contact", label: "Contact" },
];

function isCurrent(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header" data-overlay={overlay ? "" : undefined}>
  <div class="nav-inner">
    <a class="nav-brand" href="/">{profile.shortName}</a>
    <details class="nav-mobile">
      <summary class="nav-mobile-toggle">Menu</summary>
      <nav aria-label="Primary mobile">
        <ul class="nav-list nav-list-mobile">
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
    <nav class="nav-desktop" aria-label="Primary">
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
