---
import type { SiteProfile } from "../../lib/content";

interface Props {
  profile: SiteProfile;
}

const { profile } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-links" aria-label="Footer">
      <a href="/work">Work</a>
      <a href="/about">About</a>
      <a href="/writing">Writing</a>
      <a href="/contact">Contact</a>
      {
        profile.socialLinks.map((link) => (
          <a href={link.href} rel="me noopener noreferrer" target="_blank">
            {link.label}
          </a>
        ))
      }
    </div>
    <p class="muted">© {year} {profile.fullName}. Architecture with clarity and craft.</p>
    <p class="muted">
      Site photography: see <a href="/images/ATTRIBUTION.md">image attribution</a>. Replace with owned assets for production branding.
    </p>
  </div>
</footer>
