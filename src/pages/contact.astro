---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import ContactIntro from "../components/contact/ContactIntro.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import { getProfile } from "../lib/content";

const profile = getProfile();
---

<BaseLayout title="Contact" description="Start a conversation with Kevin Turnbull." path="/contact">
  <div class="page-wrap">
    <PageHeader eyebrow="Enquiries" title="Contact" lede={profile.contact.engagementNotes} />

    <section class="page-section split split-contact" aria-label="Contact details and message form">
      <ContactIntro
        email={profile.email}
        responseExpectation={profile.contact.responseExpectation}
        locationLabel={profile.locationLabel}
      />
      <ContactForm email={profile.email} formEndpoint={profile.contact.formEndpoint} />
    </section>
  </div>
</BaseLayout>
