---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import WritingList from "../../components/writing/WritingList.astro";
---

<BaseLayout
  title="Writing empty preview"
  description="Fixture for empty writing state."
  noindex={true}
>
  <div class="page-wrap">
    <PageHeader
      eyebrow="Notes"
      title="Writing"
      lede="Fixture route used to validate the empty state."
    />
    <section class="page-section" aria-label="Published writing">
      <WritingList items={[]} />
    </section>
  </div>
</BaseLayout>
