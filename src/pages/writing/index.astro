---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import WritingList from "../../components/writing/WritingList.astro";
import { getPublishedWriting } from "../../lib/content";

const items = (await getPublishedWriting()).map((w) => ({
  slug: w.id,
  title: w.data.title,
  type: w.data.type,
  date: w.data.date,
  abstract: w.data.abstract,
}));
---

<BaseLayout title="Writing" description="Essays, talks, and notes." path="/writing">
  <div class="page-wrap">
    <PageHeader
      eyebrow="Notes"
      title="Writing"
      lede="Essays and talks on architecture judgment, delivery, and design leadership."
    />
    <section class="page-section" aria-label="Published writing">
      <WritingList items={items} />
    </section>
  </div>
</BaseLayout>
