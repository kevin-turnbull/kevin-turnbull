---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/layout/PageHeader.astro";
import WorkList from "../../components/work/WorkList.astro";
import { getFeaturedCaseStudies } from "../../lib/content";

const studies = await getFeaturedCaseStudies();
const items = studies.map((s) => ({
  slug: s.id,
  title: s.data.title,
  summary: s.data.summary,
  organization: s.data.organization,
  timeframe: s.data.timeframe,
  role: s.data.role,
}));
---

<BaseLayout
  title="Work"
  description="Selected architecture engagements and outcomes."
  path="/work"
>
  <div class="page-wrap">
    <PageHeader
      eyebrow="Index"
      title="Selected work"
      lede="A curated set of engagements — the problem, the constraints, the decisions, and what held up afterwards."
    />
    <section class="page-section" aria-label="Case studies">
      <WorkList items={items} />
    </section>
  </div>
</BaseLayout>
