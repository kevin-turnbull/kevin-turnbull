---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <section class="page-wrap page-section stack-lg">
    <h1 class="section-title">Page not found</h1>
    <p class="lede">The link may be outdated, or the page moved.</p>
    <div class="cta-group">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-secondary" href="/work">Selected work</a>
    </div>
  </section>
</BaseLayout>
