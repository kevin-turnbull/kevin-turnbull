---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <div class="page-wrap">
    <PageHeader
      eyebrow="404"
      title="Page not found"
      lede="The link may be outdated, or the page has moved."
    />
    <section class="page-section" aria-label="Continue">
      <div class="cta-group">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-secondary" href="/work">Selected work</a>
      </div>
    </section>
  </div>
</BaseLayout>
