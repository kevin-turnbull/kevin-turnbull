---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import AboutNarrative from "../components/about/AboutNarrative.astro";
import PhilosophyList from "../components/about/PhilosophyList.astro";
import CareerSpine from "../components/about/CareerSpine.astro";
import { getCareer, getPhilosophy, getProfile } from "../lib/content";
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const profile = getProfile();
const philosophy = (await getPhilosophy()).map((p) => ({
  title: p.data.title,
  body: p.data.body,
}));
const career = (await getCareer()).map((c) => c.data);
const resumeOnDisk = profile.resumePdf
  ? existsSync(resolve(`public${profile.resumePdf}`))
  : false;
const showResume = Boolean(profile.resumePdf && resumeOnDisk);
---

<BaseLayout title="About" description="Background, philosophy, and career spine." path="/about">
  <div class="page-wrap">
    <PageHeader
      eyebrow="Profile"
      title="About"
      lede="I work at the intersection of product ambition and operational reality — helping organizations design systems that stay understandable as they scale."
    />

    <section class="page-section split split-about" aria-label="Practice">
      <div class="about-intro">
        <p class="eyebrow">In practice</p>
        <AboutNarrative body="A system earns its keep when the next team can reason about it without a guide." />
        {
          showResume && (
            <p>
              <a class="btn btn-secondary" href={profile.resumePdf}>
                Download résumé
              </a>
            </p>
          )
        }
      </div>
      {
        profile.portraitImage && (
          <img
            class="framed-image"
            src={profile.portraitImage}
            alt={`${profile.fullName} portrait`}
            width="900"
            height="900"
            loading="lazy"
          />
        )
      }
    </section>

    <section class="page-section" aria-labelledby="philosophy-heading">
      <div class="section-head">
        <p class="eyebrow">Principles</p>
        <h2 id="philosophy-heading" class="section-title">Philosophy</h2>
      </div>
      <PhilosophyList items={philosophy} />
    </section>

    <section class="page-section" aria-labelledby="career-heading">
      <div class="section-head">
        <p class="eyebrow">Trajectory</p>
        <h2 id="career-heading" class="section-title">Career spine</h2>
      </div>
      <CareerSpine items={career} />
    </section>
  </div>
</BaseLayout>

<style>
  .about-intro {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    justify-items: start;
    align-content: start;
  }
</style>
